<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MouseBridge</AssemblyName>
    <RootNamespace>MouseBridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>MouseBridge.ico</ApplicationIcon>
    <!-- SYSLIB1054: DllImport is fine here; not worth churning to LibraryImport.
         WFO0003: WinForms wants DPI mode set via ApplicationHighDpiMode, but that
         runs Application.SetHighDpiMode partway into Main and silently no-ops if
         anything has already touched a DPI-dependent API. The manifest applies at
         process start, which is what the hook coordinates depend on. -->
    <NoWarn>$(NoWarn);SYSLIB1054;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same file as ApplicationIcon above, so the tray shows the exe's icon. -->
    <EmbeddedResource Include="MouseBridge.ico" LogicalName="MouseBridge.ico" />
  </ItemGroup>

</Project>
