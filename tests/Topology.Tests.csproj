<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Topology.Tests</AssemblyName>
    <RootNamespace>MouseBridge</RootNamespace>
    <NoWarn>$(NoWarn);SYSLIB1054;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Topology.cs" Link="Topology.cs" />
    <Compile Include="..\Native.cs" Link="Native.cs" />
  </ItemGroup>

</Project>
