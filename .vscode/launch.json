{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MouseBridge",
            "type": "coreclr",
            "request": "launch",
            // Closes any copy already in the tray first. A second copy shuts
            // itself down straight away, which looks like nothing happened.
            "preLaunchTask": "build and restart",
            "program": "${workspaceFolder}/bin/Debug/net10.0-windows/MouseBridge.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "MouseBridge (verbose logging)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build and restart",
            "program": "${workspaceFolder}/bin/Debug/net10.0-windows/MouseBridge.exe",
            "args": [
                "--debug"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Topology scenarios",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build tests",
            "program": "${workspaceFolder}/tests/bin/Debug/net10.0-windows/Topology.Tests.exe",
            "cwd": "${workspaceFolder}/tests",
            // Prints a pass or fail line per scenario, so give it a real terminal.
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Attach to running MouseBridge",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
